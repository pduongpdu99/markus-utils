{{! Context example:
  {
    "subject": "Yêu cầu hỗ trợ dự án",
    "customerName": "Nguyễn Văn A",
    "email": "nguyenvana@example.com",
    "phone": "+84 912 345 678",
    "budget": "50.000.000 - 100.000.000 VNĐ",
    "projectType": "Website bán hàng",
    "projectGoal": "Mua sắm trực tuyến",
    "projectDescription": "Tôi muốn xây dựng một website thương mại điện tử cho cửa hàng quần áo với tính năng giỏ hàng, thanh toán và quản lý đơn hàng.",
    "timeline": "Trong vòng 2 tháng",
    "notes": "Cần tối ưu mobile, dễ quản lý bằng CMS và tích hợp Chatbot.",
    "source": "Website",
    "submittedAt": "2026-08-17"
  }
}}

<!DOCTYPE html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{{subject}}</title>
  </head>
  <body style="margin:0; padding:0; background:#f5f7fb; font-family:Arial, Helvetica, sans-serif; color:#1f2937;">
    <div style="max-width:700px; margin:32px auto; background:#ffffff; border-radius:12px; overflow:hidden; border:1px solid #e5e7eb;">
      <div style="background:#0f172a; color:#ffffff; padding:24px 32px;">
        <h2 style="margin:0; font-size:24px;">Yêu cầu hỗ trợ mới</h2>
      </div>

      <div style="padding:32px;">
        <p style="margin:0 0 20px; font-size:16px; line-height:1.6;">
          Có một yêu cầu hỗ trợ mới được gửi từ khách hàng.
        </p>

        <table style="width:100%; border-collapse:collapse; font-size:15px; line-height:1.7;">
          <tr>
            <td style="padding:8px 0; width:180px; font-weight:bold; color:#374151;">Chủ đề:</td>
            <td style="padding:8px 0; color:#111827;">{{subject}}</td>
          </tr>
          <tr>
            <td style="padding:8px 0; font-weight:bold; color:#374151;">Họ tên:</td>
            <td style="padding:8px 0; color:#111827;">{{customerName}}</td>
          </tr>
          <tr>
            <td style="padding:8px 0; font-weight:bold; color:#374151;">Email:</td>
            <td style="padding:8px 0; color:#111827;">{{email}}</td>
          </tr>
          <tr>
            <td style="padding:8px 0; font-weight:bold; color:#374151;">Điện thoại:</td>
            <td style="padding:8px 0; color:#111827;">{{phone}}</td>
          </tr>
          <tr>
            <td style="padding:8px 0; font-weight:bold; color:#374151;">Ngân sách:</td>
            <td style="padding:8px 0; color:#111827;">{{budget}}</td>
          </tr>
          <tr>
            <td style="padding:8px 0; font-weight:bold; color:#374151;">Loại dự án:</td>
            <td style="padding:8px 0; color:#111827;">{{projectType}}</td>
          </tr>
          <tr>
            <td style="padding:8px 0; font-weight:bold; color:#374151;">Mục tiêu:</td>
            <td style="padding:8px 0; color:#111827;">{{projectGoal}}</td>
          </tr>
          <tr>
            <td style="padding:8px 0; font-weight:bold; color:#374151;">Thời gian:</td>
            <td style="padding:8px 0; color:#111827;">{{timeline}}</td>
          </tr>
          <tr>
            <td style="padding:8px 0; font-weight:bold; color:#374151;">Nguồn:</td>
            <td style="padding:8px 0; color:#111827;">{{source}}</td>
          </tr>
          <tr>
            <td style="padding:8px 0; font-weight:bold; color:#374151;">Ngày gửi:</td>
            <td style="padding:8px 0; color:#111827;">{{submittedAt}}</td>
          </tr>
        </table>

        <div style="margin-top:28px; padding:20px; background:#f8fafc; border-left:4px solid #2563eb; border-radius:8px;">
          <p style="margin:0 0 8px; font-weight:bold; color:#1f2937;">Mô tả dự án:</p>
          <p style="margin:0; line-height:1.7; color:#374151; white-space:pre-line;">{{projectDescription}}</p>
        </div>

        {{#if notes}}
          <div style="margin-top:20px; padding:20px; background:#fefce8; border-left:4px solid #f59e0b; border-radius:8px;">
            <p style="margin:0 0 8px; font-weight:bold; color:#1f2937;">Ghi chú thêm:</p>
            <p style="margin:0; line-height:1.7; color:#374151; white-space:pre-line;">{{notes}}</p>
          </div>
        {{/if}}

        <div style="margin-top:28px; padding-top:20px; border-top:1px solid #e5e7eb;">
          <p style="margin:0; font-size:14px; color:#4b5563;">
            Vui lòng phản hồi lại khách hàng sớm nhất để trao đổi về dự án và ngân sách.
          </p>
        </div>
      </div>
    </div>
  </body>
</html>
