<div style="margin:0;padding:0;background-color:#f5f7fa;font-family:Arial,Helvetica,sans-serif;color:#1f2937;">
    <div style="max-width:680px;margin:0 auto;padding:32px 16px;">
        <div style="background:#111827;border-radius:12px 12px 0 0;padding:28px 32px;">
            <div style="font-size:13px;color:#9ca3af;margin-bottom:8px;">
                {{source}}
            </div>

            <h1 style="margin:0;font-size:24px;color:#ffffff;">
                {{subject}}
            </h1>
        </div>

        <div style="background:#ffffff;padding:32px;border:1px solid #e5e7eb;border-top:0;">

            <h2>Thông tin liên hệ</h2>

            <p>
                <strong>Họ và tên:</strong> {{fromName}}
            </p>

            <p>
                <strong>Email:</strong> {{email}}
            </p>

            <p>
                <strong>Số điện thoại:</strong> {{phone}}
            </p>

            <h2>Thông tin dự án</h2>

            <p>
                <strong>Loại dự án:</strong> {{projectType}}
            </p>

            <p>
                <strong>Mục tiêu:</strong> {{projectGoal}}
            </p>

            <p>
                <strong>Ngân sách:</strong> {{budget}}
            </p>

            <p>
                <strong>Thời gian:</strong> {{timeline}}
            </p>

            <h2>Mô tả dự án</h2>

            <div style="background:#f9fafb;padding:16px;border-left:4px solid #2563eb;">
                {{projectDescription}}
            </div>

            <h2>Ghi chú</h2>

            <p>
                {{notes}}
            </p>

        </div>

        <div style="padding:20px 32px;background:#f9fafb;">
            <p style="font-size:12px;color:#6b7280;">
                Email được gửi từ hệ thống {{source}}
            </p>

            <p style="font-size:12px;color:#9ca3af;">
                Thời gian gửi: {{submittedAt}}
            </p>
        </div>
    </div>
</div>